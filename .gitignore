# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Données et artefacts (volumineux, régénérables)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
models/*
!models/.gitkeep
# Les modèles entraînés sont versionnés : la tâche « Bout en bout » de l'intégration continue
# charge le modèle de substitution, et les métriques publiées ne sont reproductibles qu'avec
# les agents effectivement retenus.
!models/surrogate/
!models/predict/
!models/rl/
runs/
mlruns/
mlflow.db
outputs/

# Interface web
web/node_modules/
web/dist/
web/.vite/
web/test-results/
web/playwright-report/

